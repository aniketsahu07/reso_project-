# Supabase Configuration
# The URL of your Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The anonymous public key of your Supabase project (from Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# The service role key for admin privileges (needed for server-only operations)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Groq AI Configuration (Needed for Llama 3.1 BuildPlan Architect & Skill Match scoring)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional: Groq LLM model to use (defaults to 'llama-3.1-8b-instant' if not specified)
# GROQ_MODEL=llama-3.1-8b-instant

# AI Provider select: 'groq' (default) or 'ollama'
AI_PROVIDER=groq

# Ollama Local AI Configuration
# Default Ollama address is http://127.0.0.1:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Model name to use (e.g., llama3.1, llama3, gemma2, etc.)
OLLAMA_MODEL=llama3.1

